artifacts/local_demo_report.*

# Volatile verification runtime log (non-reproducible: embeds random pip temp paths
# and per-build wheel sha256). Regenerated by `make verify-release`, never pinned.
artifacts/verification/VERIFY_RELEASE.log

# Per-run gate outputs (environment inventory + license snapshot). Regenerated by
# the env-check / license-audit gates and uploaded as CI artifacts; not pinned.
artifacts/verification/environment.json
artifacts/security/licenses.json

# Resource-effectiveness report embeds per-run wall-time (non-reproducible).
# Regenerated by the resource-effectiveness gate; never pinned.
artifacts/verification/RESOURCE_EFFECTIVENESS.json

# Institutional gate reports — regenerated by their gates each run (the gate, not
# the committed file, is the source of truth). "Missing artifact = fail" is enforced
# by running the gate, which always writes its report.
artifacts/verification/PRODUCT_CLAIM_AUDIT.json
artifacts/verification/BENCHMARK_CARD.json
artifacts/verification/CONTAMINATION_AUDIT.json
artifacts/verification/CROSS_DOMAIN_MATRIX.json
artifacts/verification/DOMAIN_DISTANCE_POLICY.json
artifacts/verification/MISUSE_THREAT_MODEL_AUDIT.json
artifacts/verification/EXTERNAL_REPLICATION_READINESS.json
artifacts/verification/CAPABILITY_REGISTRY.json
artifacts/verification/INSTITUTIONAL_SCORECARD.json
artifacts/verification/RELEASE_TIMINGS.json
