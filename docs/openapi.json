    "/api/v1/reports/from-upload": {
      "post": {
        "description": "Analyse an uploaded transcript file in any supported container format.\n\nThe raw request body is the file's bytes. The format is taken from the\noptional ``format`` query parameter, else inferred from ``x-bive-filename``\nand the content. This keeps the endpoint dependency-free (no multipart) while\naccepting a browser ``File`` object or ``curl --data-binary`` directly.",
        "operationId": "create_report_from_upload_api_v1_reports_from_upload_post",
        "parameters": [
